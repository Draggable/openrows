# docker/compose.sh dev reads docker/.env.dev, or this file when there is none. Every value here
# is a well-known development default (the server refuses them with NODE_ENV=production), so it
# works as-is. Copy it to docker/.env.dev (git-ignored) to change something.

# Postgres. PG_USER is the superuser the migrate one-shot connects as; the api and worker
# connect as openrows_app with OPENROWS_APP_DB_PASSWORD (docs/deploy/database.md).
PG_DB=openrows
PG_USER=openrows
PG_PASSWORD=openrows_dev
OPENROWS_APP_DB_PASSWORD=openrows_app_dev

# The app as the browser sees it (the api serves the client). The dev realm registers
# ${APP_URL}/auth/callback.
APP_URL=http://localhost:8180
LOG_LEVEL=info
ENCRYPTION_KEY=dev-only-encryption-key-do-not-use-in-production

# Sign-in: the dev Keycloak and realm from dev.yml (docker/keycloak/openrows-realm.json).
# dev user: dev@openrows.test / openrows-dev-password
OIDC_ISSUER_URL=http://localhost:8080/realms/openrows
OIDC_CLIENT_ID=openrows-app
OIDC_CLIENT_SECRET=openrows-dev-client-secret
OIDC_ADMIN_CLIENT_ID=openrows-admin
OIDC_ADMIN_CLIENT_SECRET=openrows-dev-admin-secret
# The api's service account for workspaces' single sign-on providers (hosted edition).
OIDC_SSO_CLIENT_ID=openrows-sso
OIDC_SSO_CLIENT_SECRET=openrows-dev-sso-secret
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin

# S3: the dev S3 server (versitygw) in dev.yml, which creates the bucket. The host reaches it
# at http://localhost:9000.
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_BUCKET=openrows
S3_ACCESS_KEY=openrows-dev
S3_SECRET_KEY=openrows-dev-secret
S3_PUBLIC_URL=http://localhost:9000/openrows

# The app's mail goes to Mailpit (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false

# Valkey is off. To turn it on: COMPOSE_PROFILES=valkey and REDIS_URL=redis://valkey:6379
# COMPOSE_PROFILES=valkey
# REDIS_URL=redis://valkey:6379
# VALKEY_PASSWORD=
