# A self-hosted production stack: docker/compose.yml + docker/selfhost.yml
# (docs/guide/self-hosting.md "A production stack"). Copy this file OUTSIDE the checkout, make it
# mode 600 (chmod 600) and fill in every empty value that applies. Compose refuses to start while
# a required value is empty, and the server refuses defaults, placeholders and http URLs in
# production. Generate secrets with `openssl rand -hex 32` (passwords that go into URLs must be
# URL-safe: hex is) and ENCRYPTION_KEY with `openssl rand -base64 32`.

# The image: build it from this checkout (`docker compose ... build`, tag openrows:local), or run a
# published one, e.g. IMAGE=ghcr.io/draggable/openrows:sha-<full commit sha> (then `pull` and
# `up --no-build`). Use the docker/ directory of the same commit as the image.
#IMAGE=

# Where the api listens on the host, for your reverse proxy or tunnel (loopback only by default).
OPENROWS_BIND=127.0.0.1:3000

# Postgres (the stack's own, compose.yml): the superuser migrate uses, and the password migrate
# gives the openrows_app role the api and worker connect as (row-level security applies to it).
PG_DB=openrows
PG_USER=openrows
PG_PASSWORD=
OPENROWS_APP_DB_PASSWORD=

LOG_LEVEL=info
# The browser-facing https origin; OIDC redirects to ${APP_URL}/auth/callback.
APP_URL=
# Behind a reverse proxy that sets X-Forwarded-For: true, and how many proxies append to it.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1
# 32 random bytes, base64: encrypts the login cookie, stored tokens and webhook secrets.
ENCRYPTION_KEY=

# Sign-in: any OpenID Connect provider that issues verified emails (docs/deploy/keycloak.md).
# With the `keycloak` profile, OIDC_ISSUER_URL is ${KC_HOSTNAME}/realms/openrows.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=openrows-app
OIDC_CLIENT_SECRET=
# Optional: deleting an account also deletes its Keycloak user (a service account with
# realm-management's manage-users).
OIDC_ADMIN_CLIENT_ID=
OIDC_ADMIN_CLIENT_SECRET=
# Optional "Continue with" buttons: identity-provider aliases in the realm, e.g. github,google.
AUTH_PROVIDERS=
# System admins: comma-separated emails (they get no tenant access).
OPENROWS_SYSTEM_ADMINS=

# Object storage: any S3-compatible bucket, path-style; browsers upload and download through
# presigned URLs, so it must be reachable from them (docker/README.md "S3").
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# The app's own mail (invitations, notifications, digests). Empty SMTP_HOST: mail is logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile for public forms and password-protected links: both or neither.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Optional profiles: keycloak, clamav, valkey (comma-separated).
COMPOSE_PROFILES=

# With the keycloak profile: Keycloak's public https origin, its database password (not
# PG_PASSWORD), the first start's temporary admin, and its mail (verification, password reset).
KC_HOSTNAME=
KEYCLOAK_BIND=127.0.0.1:8080
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USER=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
OPENROWS_KC_SMTP_HOST=
OPENROWS_KC_SMTP_PORT=587
OPENROWS_KC_SMTP_FROM=
OPENROWS_KC_SMTP_AUTH=false
OPENROWS_KC_SMTP_USER=
OPENROWS_KC_SMTP_PASSWORD=
OPENROWS_KC_SMTP_STARTTLS=false
OPENROWS_KC_SMTP_SSL=false

# With the clamav profile: CLAMAV_URL=tcp://clamav:3310 (uploads wait for a clean scan).
CLAMAV_URL=
# With the valkey profile: REDIS_URL=redis://:<VALKEY_PASSWORD>@valkey:6379
VALKEY_PASSWORD=
REDIS_URL=
