# =============================================================================
# OpenRows Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment.
# Validated at startup by packages/server/src/config.ts. Development works with no .env at all.
# With NODE_ENV=production the server refuses to start if APP_URL, DATABASE_URL, ENCRYPTION_KEY,
# the OIDC_* or the S3_* values are missing, still hold a default or placeholder (openrows_dev,
# minioadmin, change-me...), or if APP_URL / OIDC_ISSUER_URL aren't https.

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# The server connects as openrows_app, a role row-level security applies to (ADR-002).
# Migrations connect as the schema owner and give openrows_app its password.
# Roles per environment: docs/deploy/database.md. These are the dev defaults.
DATABASE_URL=postgresql://openrows_app:openrows_app_dev@localhost:5432/openrows
MIGRATION_DATABASE_URL=postgresql://openrows:openrows_dev@localhost:5432/openrows
OPENROWS_APP_DB_PASSWORD=openrows_app_dev

# -----------------------------------------------------------------------------
# Authentication (Keycloak or any OIDC provider, ADR-006)
# -----------------------------------------------------------------------------
# Optional in development (all three or none), required in production. Without them the app
# runs, but /auth/login answers 503. The values below match the dev realm in the Compose dev
# stack (docker/README.md):
#   docker/compose.sh dev up -d --wait
# Production: docs/deploy/keycloak.md.
# OIDC_ISSUER_URL=http://localhost:8080/realms/openrows
# OIDC_CLIENT_ID=openrows-app
# OIDC_CLIENT_SECRET=openrows-dev-client-secret
# OIDC_SCOPES=openid email profile
# System admins (ADR-002, the ops console): comma-separated emails, synced at each sign-in with
# a verified email. Empty: sign-in leaves users.is_system_admin as set by hand in the database.
# OPENROWS_SYSTEM_ADMINS=
# Encrypts stored OIDC tokens and the login cookie. At least 32 characters; generate with `openssl rand -base64 32`.
# Optional in development (a dev-only key is used), required in production.
# ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# File Storage (S3-compatible: Cloudflare R2, AWS S3, MinIO, ...)
# -----------------------------------------------------------------------------
# Optional in development (endpoint, bucket and both keys, or none), required in production.
# /ready checks the bucket when these are set. The values below are the Compose dev stack's S3
# server (versitygw); minioadmin and other defaults are rejected in production.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openrows-dev
S3_SECRET_KEY=openrows-dev-secret
S3_BUCKET=openrows
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/openrows

# -----------------------------------------------------------------------------
# Email (the app's own mail; Keycloak sends sign-up and reset mail itself)
# -----------------------------------------------------------------------------
# Unset: mail is logged, not sent. In development, Mailpit from the Compose dev stack
# (UI at http://localhost:8025). Use 127.0.0.1, not localhost (nodemailer doesn't fall back
# from ::1).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_SECURE=false   # true: implicit TLS (465); starttls: STARTTLS required (587)
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=OpenRows <noreply@openrows.io>

# -----------------------------------------------------------------------------
# Redis (optional; /ready checks it when set)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# Realtime fan-out (ADR-003): postgres (LISTEN/NOTIFY, default) or redis (not implemented, M5)
# EVENT_BUS=postgres

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Public origin of the app as the browser sees it (https in production). Also the CORS origin.
APP_URL=http://localhost:5173
# Set to true behind a reverse proxy (nginx, Traefik): then X-Forwarded-For gives the client IP
# (rate limits, session records) and the proxy's X-Request-Id is reused. With it off,
# X-Forwarded-For is ignored, because any client can send it.
TRUST_PROXY=false
# Number of proxies that append to X-Forwarded-For (Cloudflare + nginx = 2). Only with TRUST_PROXY.
# TRUST_PROXY_HOPS=1
# Requests per minute per client IP on /auth/* (default 30).
# AUTH_RATE_LIMIT=30
# Requests per minute per client IP on the public share link API (/api/shared/*)
# SHARE_RATE_LIMIT=600
# The API's token buckets, shared by every instance through Postgres: requests per second
# and burst per base on /api/v1 (Airtable's 5/s), and per personal access token (any route) or
# signed-in user (/api/v1) (Airtable's 50/s). RATE_LIMIT_STORE=memory keeps them per process.
# API_RATE_LIMIT_BASE=5
# API_RATE_LIMIT_BASE_BURST=10
# API_RATE_LIMIT_TOKEN=50
# API_RATE_LIMIT_TOKEN_BURST=100
# RATE_LIMIT_STORE=postgres
# Stale records per computed field (lookup, rollup, count, formula) a write recomputes in its
# request; a field with more shows as updating until the worker has recomputed it
# COMPUTED_SYNC_LIMIT=5000
# Outbound requests to user-chosen URLs (webhooks, automations, the Airtable import) go
# through an SSRF-safe client: https only, ports 80 and 443, public addresses only. Self-hosters
# can allow http, more ports and internal targets (IPs, CIDRs, hostnames, *.suffix), or deny
# more; the deny list wins, and the cloud metadata service is never reachable.
# OUTBOUND_HTTP_ALLOW_HTTP=false
# OUTBOUND_HTTP_PORTS=5678
# OUTBOUND_HTTP_ALLOW=n8n.lan,10.0.5.0/24
# OUTBOUND_HTTP_DENY=
# AI providers: any OpenAI-compatible chat completions API (OpenAI, Anthropic's
# compatible endpoint https://api.anthropic.com/v1, OpenRouter, Ollama at http://host:11434/v1).
# With AI_MODEL set, AI features are on in every workspace with this provider; its host is
# reachable even when private. Without it, owners can still bring their own key in Settings → AI.
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini
# AI_API_KEY=
# The hosts a workspace's own base URL may use (*.suffix allowed); unset: any public host the
# outbound rules allow. The hosted service lists the providers it supports.
# AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,openrouter.ai
# AI_TIMEOUT_SECONDS=60
# The hosted edition (EDITION=cloud) ignores AI_* and runs AI on its own provider, metered in
# AI credits per plan (the hosted plan catalog); without the key it is off (bring your own key only).
# OPENROWS_HOSTED_AI_BASE_URL=https://ai.example.com/api
# OPENROWS_HOSTED_AI_MODEL=
# OPENROWS_HOSTED_AI_API_KEY=
# Google Sheets as a sync source (hosted edition only): a Google Cloud OAuth client of its
# own (not the sign-in IdP's), redirect URI <APP_URL>/api/me/sync-connectors/google-sheets/callback,
# scopes spreadsheets.readonly and drive.metadata.readonly. Unset: the source is hidden.
# OPENROWS_GOOGLE_SHEETS_CLIENT_ID=
# OPENROWS_GOOGLE_SHEETS_CLIENT_SECRET=
# The worker's attachment GC: stored files no row names any more (purged records, fields
# and bases, uploads never confirmed after 24 h). `dry-run` only counts them (worker logs and
# /metrics), `on` deletes them, `off` skips the job.
# ATTACHMENT_GC=dry-run
# Emails automations may send per workspace and UTC day, one per recipient (the worker).
# AUTOMATION_EMAIL_DAILY_LIMIT=100
# Per-workspace outbound limits (the worker): webhook deliveries and automations' HTTP,
# Slack, email and run-script fetch requests per minute (0 turns the rate off) with a burst, and
# webhook deliveries (and automation runs) active at once per workspace. Over the limits, work
# is delayed in the queue, never dropped.
# OUTBOUND_WORKSPACE_RATE_PER_MINUTE=600
# OUTBOUND_WORKSPACE_BURST=100
# OUTBOUND_WORKSPACE_CONCURRENCY=4
# Run-script automation steps (the worker, and the api for test runs and retries). Off by
# default. `local-container` runs each script in a throwaway `docker run` (no network, read-only,
# nobody, no capabilities, limits) through the docker CLI on the host's Docker, so the process
# needs the CLI and the daemon: read docs/deploy/automation-scripts.md first. Pull the image
# before turning it on (runs never pull): docker pull <AUTOMATION_SCRIPT_IMAGE>.
# AUTOMATION_SCRIPTS=off
# AUTOMATION_SCRIPT_IMAGE=node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d
# AUTOMATION_SCRIPT_DOCKER=docker
# AUTOMATION_SCRIPT_RUNTIME=runsc
# AUTOMATION_SCRIPT_TIMEOUT_SECONDS=30
# AUTOMATION_SCRIPT_CPU_SECONDS=10
# AUTOMATION_SCRIPT_MEMORY_MB=128
# AUTOMATION_SCRIPT_CONCURRENCY=4
# Who may install third-party extension bundles in a base's extension panel: creators
# (and owners), owners, or off (built-in extensions only). Unset: owners with EDITION=cloud,
# else creators. Bundles run in a sandboxed frame with only their manifest's scopes.
# EXTENSIONS_CUSTOM_BUNDLES=creators
# Public form submissions per client IP and form per 10 minutes; 50x per form.
# FORM_SUBMIT_RATE_LIMIT=20
# Cloudflare Turnstile for public forms: both or neither. Without them forms have no
# CAPTCHA, which only development allows; production refuses to publish or accept forms.
# Cloudflare's test keys (always pass): secret 1x0000000000000000000000000000000AA,
# site key 1x00000000000000000000AA.
# TURNSTILE_SECRET_KEY=
# TURNSTILE_SITE_KEY=
# fatal | error | warn | info | debug | trace | silent (default info; silent under tests)
# LOG_LEVEL=info
# Serve the built client (packages/client/dist) from the server too, on one origin. The Docker
# image sets it; in development Vite serves the client instead.
# CLIENT_DIR=packages/client/dist

# -----------------------------------------------------------------------------
# Client Configuration (Vite environment variables)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:3000/ws

# -----------------------------------------------------------------------------
# Docker Compose
# -----------------------------------------------------------------------------
# The Compose stacks read their own env files, not this one: docker/.env.dev.example and
# docker/.env.prod.example (docker/README.md).
