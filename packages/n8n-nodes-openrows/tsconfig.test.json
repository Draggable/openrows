{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.test.tsbuildinfo"
  },
  "include": ["src/**/*.test.ts", "test/**/*.ts", "vitest.config.mts"],
  "references": [{ "path": "./tsconfig.build.json" }, { "path": "../shared/tsconfig.build.json" }]
}
