{"id": "full-name", "prompt": "First and last name joined with a space", "fields": [{"name": "First", "type": "singleLineText"}, {"name": "Last", "type": "singleLineText"}], "records": [{"cells": {"First": "Ada", "Last": "Lovelace"}, "expected": "Ada Lovelace"}]}
{"id": "upper-code", "prompt": "The product code in upper case", "fields": [{"name": "Code", "type": "singleLineText"}], "records": [{"cells": {"Code": "ab-12"}, "expected": "AB-12"}]}
{"id": "lower-email", "prompt": "The email address in lower case", "fields": [{"name": "Email", "type": "email"}], "records": [{"cells": {"Email": "Ada@Example.COM"}, "expected": "ada@example.com"}]}
{"id": "initials", "prompt": "The initials of the first and last name, like AL", "fields": [{"name": "First", "type": "singleLineText"}, {"name": "Last", "type": "singleLineText"}], "records": [{"cells": {"First": "Ada", "Last": "Lovelace"}, "expected": "AL"}]}
{"id": "name-length", "prompt": "How many characters the name has", "fields": [{"name": "Name", "type": "singleLineText"}], "records": [{"cells": {"Name": "Hello"}, "expected": 5}, {"cells": {"Name": "Hi"}, "expected": 2}]}
{"id": "trimmed-title", "prompt": "The title without spaces at the start or end", "fields": [{"name": "Title", "type": "singleLineText"}], "records": [{"cells": {"Title": "  Hi there  "}, "expected": "Hi there"}]}
{"id": "email-domain", "prompt": "The domain part of the email address, after the @", "fields": [{"name": "Email", "type": "email"}], "records": [{"cells": {"Email": "ada@example.com"}, "expected": "example.com"}, {"cells": {"Email": "bob@mail.openrows.io"}, "expected": "mail.openrows.io"}]}
{"id": "phone-digits", "prompt": "The phone number with the dashes removed", "fields": [{"name": "Phone", "type": "phone"}], "records": [{"cells": {"Phone": "555-123-4567"}, "expected": "5551234567"}]}
{"id": "greeting", "prompt": "\"Hello, \" then the name and an exclamation mark", "fields": [{"name": "Name", "type": "singleLineText"}], "records": [{"cells": {"Name": "Ada"}, "expected": "Hello, Ada!"}]}
{"id": "first-word", "prompt": "The first word of the title", "fields": [{"name": "Title", "type": "singleLineText"}], "records": [{"cells": {"Title": "Quarterly report draft"}, "expected": "Quarterly"}, {"cells": {"Title": "Single"}, "expected": "Single"}]}
{"id": "tags-joined", "prompt": "All tags joined with a semicolon and a space", "fields": [{"name": "Tags", "type": "multipleSelect"}], "records": [{"cells": {"Tags": ["red", "blue"]}, "expected": "red; blue"}]}
{"id": "slug", "prompt": "A URL slug: the name in lower case with spaces replaced by dashes", "fields": [{"name": "Name", "type": "singleLineText"}], "records": [{"cells": {"Name": "My Big Idea"}, "expected": "my-big-idea"}]}
{"id": "rating-stars", "prompt": "A star (*) repeated as many times as the rating", "fields": [{"name": "Rating", "type": "rating"}], "records": [{"cells": {"Rating": 3}, "expected": "***"}]}
{"id": "mentions-urgent", "prompt": "1 when the notes mention \"urgent\" in any case, otherwise 0", "fields": [{"name": "Notes", "type": "longText"}], "records": [{"cells": {"Notes": "This is URGENT"}, "expected": 1}, {"cells": {"Notes": "all calm"}, "expected": 0}]}
{"id": "status-label", "prompt": "The status in square brackets, like [Done]", "fields": [{"name": "Status", "type": "singleSelect"}], "records": [{"cells": {"Status": "Done"}, "expected": "[Done]"}]}
