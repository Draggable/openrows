{"id": "pass-fail", "prompt": "Pass when the score is at least 50, otherwise Fail", "fields": [{"name": "Score", "type": "number"}], "records": [{"cells": {"Score": 50}, "expected": "Pass"}, {"cells": {"Score": 49}, "expected": "Fail"}]}
{"id": "done-yes-no", "prompt": "Yes when Done is checked, otherwise No", "fields": [{"name": "Done", "type": "checkbox"}], "records": [{"cells": {"Done": true}, "expected": "Yes"}, {"cells": {"Done": false}, "expected": "No"}]}
{"id": "priority-number", "prompt": "The priority as a number: High 3, Medium 2, Low 1, anything else 0", "fields": [{"name": "Priority", "type": "singleSelect"}], "records": [{"cells": {"Priority": "High"}, "expected": 3}, {"cells": {"Priority": "Low"}, "expected": 1}, {"cells": {"Priority": "Other"}, "expected": 0}]}
{"id": "both-approved", "prompt": "1 when both the Legal and the Finance approvals are checked, otherwise 0", "fields": [{"name": "Legal", "type": "checkbox"}, {"name": "Finance", "type": "checkbox"}], "records": [{"cells": {"Legal": true, "Finance": true}, "expected": 1}, {"cells": {"Legal": true, "Finance": false}, "expected": 0}]}
{"id": "missing-email", "prompt": "Missing when the email is empty, otherwise OK", "fields": [{"name": "Email", "type": "email"}], "records": [{"cells": {"Email": null}, "expected": "Missing"}, {"cells": {"Email": "a@b.co"}, "expected": "OK"}]}
{"id": "size-bucket", "prompt": "Small under 10, Medium under 100, otherwise Large", "fields": [{"name": "Count", "type": "number"}], "records": [{"cells": {"Count": 5}, "expected": "Small"}, {"cells": {"Count": 50}, "expected": "Medium"}, {"cells": {"Count": 500}, "expected": "Large"}]}
{"id": "overdue", "prompt": "Overdue when the due date is before today and the task is not done, otherwise On track", "fields": [{"name": "Due", "type": "date"}, {"name": "Done", "type": "checkbox"}], "records": [{"cells": {"Due": "2026-06-01", "Done": false}, "expected": "Overdue"}, {"cells": {"Due": "2026-06-01", "Done": true}, "expected": "On track"}, {"cells": {"Due": "2026-07-01", "Done": false}, "expected": "On track"}]}
{"id": "vip", "prompt": "VIP when spend is over 1000 or the tier is Gold, otherwise Regular", "fields": [{"name": "Spend", "type": "currency"}, {"name": "Tier", "type": "singleSelect"}], "records": [{"cells": {"Spend": 1500, "Tier": "Silver"}, "expected": "VIP"}, {"cells": {"Spend": 100, "Tier": "Gold"}, "expected": "VIP"}, {"cells": {"Spend": 100, "Tier": "Silver"}, "expected": "Regular"}]}
{"id": "letter-grade", "prompt": "A from 90, B from 80, C from 70, otherwise F", "fields": [{"name": "Score", "type": "number"}], "records": [{"cells": {"Score": 95}, "expected": "A"}, {"cells": {"Score": 72}, "expected": "C"}, {"cells": {"Score": 10}, "expected": "F"}]}
{"id": "filled-phones", "prompt": "How many of the three phone fields are filled in", "fields": [{"name": "Home", "type": "singleLineText"}, {"name": "Work", "type": "singleLineText"}, {"name": "Mobile", "type": "singleLineText"}], "records": [{"cells": {"Home": "1", "Work": null, "Mobile": "3"}, "expected": 2}]}
{"id": "balance-sign", "prompt": "Positive, Negative or Zero for the balance", "fields": [{"name": "Balance", "type": "currency"}], "records": [{"cells": {"Balance": -5}, "expected": "Negative"}, {"cells": {"Balance": 0}, "expected": "Zero"}, {"cells": {"Balance": 3}, "expected": "Positive"}]}
{"id": "full-address", "prompt": "Street, city and postcode joined with commas", "fields": [{"name": "Street", "type": "singleLineText"}, {"name": "City", "type": "singleLineText"}, {"name": "Postcode", "type": "singleLineText"}], "records": [{"cells": {"Street": "1 Main St", "City": "Leeds", "Postcode": "LS1"}, "expected": "1 Main St, Leeds, LS1"}]}
