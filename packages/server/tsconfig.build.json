{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/__fixtures__/**"],
  "references": [
    { "path": "../shared/tsconfig.build.json" },
    { "path": "../sdk/tsconfig.build.json" },
    { "path": "../mcp-server/tsconfig.build.json" }
  ]
}
